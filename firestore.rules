rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to validate incoming complaint data
    function isValidComplaint(data) {
      return data.title is string &&
             data.category is string &&
             data.status is string &&
             data.department is string;
    }

    // Complaints collection rules
    match /complaints/{complaintId} {
      allow read: if true;
      allow create: if isValidComplaint(request.resource.data);
      allow update: if isValidComplaint(request.resource.data);
      allow delete: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
