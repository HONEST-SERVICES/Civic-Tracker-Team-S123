rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Complaints collection rules
    match /complaints/{complaintId} {
      allow read: if true;
      allow write: if true;
    }

    // Users collection rules
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Municipal units collection rules
    match /units/{unitId} {
      allow read: if true;
      allow write: if true;
    }

    // Municipal wards and jurisdiction collection rules
    match /wards/{wardId} {
      allow read: if true;
      allow write: if true;
    }

    // Public facilities collection rules
    match /public_facilities/{facilityId} {
      allow read: if true;
      allow write: if true;
    }

    // Default fallback for any subcollections or custom collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
